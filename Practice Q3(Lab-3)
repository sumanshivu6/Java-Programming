import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        
        // Reading the voter's age
        int age = scanner.nextInt();
        
        try {
            // Validating voter eligibility
            if (age < 18) {
                throw new IllegalArgumentException("Age must be 18 or older to vote.");
            }
            
            System.out.println("Voter is eligible to vote.");
            
        } catch (IllegalArgumentException e) {
            // Handling the exception thrown for underage voters
            System.out.println("Exception: " + e.getMessage());
        }
        
        scanner.close();
    }
}
